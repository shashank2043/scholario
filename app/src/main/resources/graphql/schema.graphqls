directive @auth(role: Role) on FIELD_DEFINITION | OBJECT

type Query {
    getBookById(id: ID!): Book
    searchBooks(title: String, isbn: String): [Book]
    getBooksByFaculty(facultyId: ID!): [Book]
    getBookVersions(bookId: ID!): [Book]

    # User Queries
    getUserById(id: ID!): User
    getFacultyList: [User]
    getStudentList: [User]
    getDepartments: [Department]

    # Reservation Queries
    getReservationQueue(bookId: ID!): [Reservation]
    getUserReservations(userId: ID!): [Reservation]
    getCourseById(id: ID!): Course
    getCoursesByFaculty(facultyId: ID!): [Course]
    getCourseMaterials(courseId: ID!): [CourseMaterial]
    getBooksByCourse(courseId: ID!): [Book]

    # Review Queries
    getReviewStatus(bookId: ID!): ReviewRequest
    getReviewHistory(bookId: ID!): [ReviewHistory]
}

type Mutation {
    createBook(input: BookInput!): Book
    updateBook(id: ID!, input: BookInput!): Book
    deleteBook(id: ID!): Book
    publishBook(id: ID!): Book
    archiveBook(id: ID!): Book
    versionBook(input: BookVersionInput!): Book

    # User Mutations
    registerUser(input: UserInput!): User
    updateUserProfile(id: ID!, input: ProfileInput!): User
    assignRole(userId: ID!, role: Role!): User @auth(role: ADMIN)
    linkFacultyToDepartment(facultyId: ID!, departmentId: ID!): User @auth(role: ADMIN)

    # Reservation Mutations
    reserveBook(input: ReservationInput!): Reservation
    cancelReservation(reservationId: ID!): Reservation
    allocateReservedBook(bookId: ID!): Reservation
    createCourse(input: CourseInput!): Course
    updateCourse(id: ID!, input: CourseInput!): Course
    assignBookToCourse(input: CourseMaterialInput!): CourseMaterial
    updateCourseMaterial(id: ID!, mandatory: Boolean): CourseMaterial
    removeBookFromCourse(id: ID!): CourseMaterial

    # Review Mutations
    submitBookForReview(bookId: ID!, reviewerId: ID): ReviewRequest
    approveBook(requestId: ID!, feedback: String): ReviewRequest
    rejectBook(requestId: ID!, feedback: String): ReviewRequest
    requestChanges(requestId: ID!, feedback: String): ReviewRequest
}

type ReviewRequest {
    id: ID
    bookId: ID
    reviewerId: ID
    status: String
    feedback: String
    createdAt: String
    updatedAt: String
}

type ReviewHistory {
    id: ID
    reviewRecordId: ID
    status: String
    feedback: String
    performedBy: ID
    timestamp: String
}

type Reservation {
    id: ID
    bookId: ID
    userId: ID
    reservedAt: String
    expiresAt: String
    status: String
}

input ReservationInput {
    bookId: ID!
    userId: ID!
}

type User {
    id: ID
    username: String
    email: String
    fullName: String
    role: Role
    department: Department
    createdAt: String
    updatedAt: String
}

type Department {
    id: ID
    name: String
    code: String
}

enum Role {
    ADMIN
    FACULTY
    STUDENT
    LIBRARIAN
}

input UserInput {
    username: String!
    email: String!
    fullName: String!
    role: Role!
    password: String!
}

input ProfileInput {
    fullName: String
    email: String
}

type Book {
    title: String
    isbn: String
    facultyId: ID
    description: String
    versionNumber: Int
    state: BookState
    parentBookId: ID
    createdAt: String
    updatedAt: String
}

interface BookState {
    type: String
}

type Draft implements BookState {
    type: String
}

type Review implements BookState {
    type: String
}

type Published implements BookState {
    type: String
}

type Archived implements BookState {
    type: String
}

input BookInput {
    title: String!
    isbn: String!
    facultyId: ID!
    description: String
}

input BookVersionInput {
    parentBookId: ID!
    title: String
    isbn: String!
    description: String
}

type Course {
    id: ID
    courseCode: String
    title: String
    description: String
    facultyId: ID
    createdAt: String
    updatedAt: String
}

type CourseMaterial {
    id: ID
    courseId: ID
    bookId: ID
    mandatory: Boolean
    createdAt: String
    updatedAt: String
}

input CourseInput {
    courseCode: String!
    title: String!
    description: String
    facultyId: ID
}

input CourseMaterialInput {
    courseId: ID!
    bookId: ID!
    mandatory: Boolean
}
